# GenLayer studionet configuration
# Copy this to .env.local and fill in your values

# Your deployed ClauseGuard contract address (from GenLayer Studio)
NEXT_PUBLIC_CONTRACT_ADDRESS=0xYOUR_CONTRACT_ADDRESS_HERE

# Reown (WalletConnect) Project ID — get one at https://cloud.reown.com
NEXT_PUBLIC_PROJECT_ID=YOUR_REOWN_PROJECT_ID_HERE
